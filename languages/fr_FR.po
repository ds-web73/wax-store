#: patterns/404.php
msgctxt "Pattern title"
msgid "Page not found"
msgstr "Page introuvable"

#: patterns/404.php:14
msgid "This page is not in the bins"
msgstr "Cette page n’est pas dans les bacs"

#: patterns/404.php:19
msgid ""
"The address may be wrong, or the page has moved. Search the site or go back "
"to the home page."
msgstr ""
"L’adresse est peut-être erronée, ou la page a été déplacée. Faites une "
"recherche ou revenez à l’accueil."

#: patterns/divider-section.php
msgctxt "Pattern title"
msgid "Bin divider"
msgstr "Intercalaire"

#: patterns/divider-section.php
msgctxt "Pattern description"
msgid "A section title on a bin divider tab, followed by a short text."
msgstr ""
"Un titre de section sur un onglet d’intercalaire, suivi d’un court texte."

#: patterns/divider-section.php:15
msgid "New arrivals"
msgstr "Nouveaux arrivages"

#: patterns/divider-section.php:20
msgid "Fresh from the latest collections we bought. First come, first served."
msgstr ""
"Tout frais, issus des dernières collections rachetées. Premier arrivé, "
"premier servi."

