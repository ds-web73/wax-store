{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1280px"
		},
		"color": {
			"palette": [
				{
					"slug": "sleeve",
					"name": "Sleeve",
					"color": "#ECEEF0"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#1E2433"
				},
				{
					"slug": "groove",
					"name": "Groove",
					"color": "#4A5163"
				},
				{
					"slug": "divider",
					"name": "Divider",
					"color": "#F2C12E"
				},
				{
					"slug": "sticker",
					"name": "Price sticker",
					"color": "#C2391F"
				},
				{
					"slug": "board",
					"name": "Board",
					"color": "#FFFFFF"
				}
			],
			"defaultPalette": false,
			"defaultGradients": false,
			"gradients": [],
			"duotone": []
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "Tiny",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "Small",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "Medium",
					"size": "clamp(1.25rem, 2vw, 1.75rem)"
				},
				{
					"slug": "50",
					"name": "Large",
					"size": "clamp(2rem, 4vw, 3rem)"
				},
				{
					"slug": "60",
					"name": "Extra large",
					"size": "clamp(3rem, 7vw, 5.5rem)"
				}
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "archivo",
					"name": "Archivo",
					"fontFamily": "\"Archivo\", \"Arial Narrow\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Archivo",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontStretch": "62% 125%",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/archivo.woff2"
							]
						}
					]
				},
				{
					"slug": "source-serif",
					"name": "Source Serif 4",
					"fontFamily": "\"Source Serif 4\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-serif-4.woff2"
							]
						},
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "italic",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-serif-4-italic.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.0625rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.375rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "2rem",
					"fluid": {
						"min": "1.625rem",
						"max": "2.5rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Huge",
					"size": "3.5rem",
					"fluid": {
						"min": "2.5rem",
						"max": "4.5rem"
					}
				}
			]
		},
		"custom": {
			"tab": {
				"radius": "6px",
				"bar": "6px"
			},
			"onDivider": "#1E2433",
			"onSticker": "#FFFFFF"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--sleeve)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--archivo)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.55"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "800",
					"lineHeight": "1.05",
					"fontFamily": "var(--wp--preset--font-family--archivo)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--ink)",
					"text": "var(--wp--preset--color--sleeve)"
				},
				"border": {
					"radius": "3px"
				},
				"typography": {
					"fontWeight": "700",
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"spacing": {
					"padding": {
						"top": "0.7em",
						"bottom": "0.7em",
						"left": "1.3em",
						"right": "1.3em"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--divider)",
						"text": "var(--wp--preset--color--ink)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--divider)",
						"text": "var(--wp--preset--color--ink)"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--groove)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "800",
					"lineHeight": "1"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/site-tagline": {
				"color": {
					"text": "var(--wp--preset--color--groove)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-excerpt": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--source-serif)"
				}
			},
			"core/post-date": {
				"color": {
					"text": "var(--wp--preset--color--groove)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/post-featured-image": {
				"border": {
					"radius": "2px"
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--source-serif)",
					"fontStyle": "italic",
					"fontSize": "var(--wp--preset--font-size--large)"
				},
				"border": {
					"left": {
						"color": "var(--wp--preset--color--divider)",
						"width": "6px",
						"style": "solid"
					}
				},
				"spacing": {
					"padding": {
						"left": "1.25rem"
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--groove)"
				}
			},
			"core/query-pagination": {
				"typography": {
					"fontWeight": "700"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-no-title",
			"title": "Page without title",
			"postTypes": [
				"page"
			]
		}
	]
}